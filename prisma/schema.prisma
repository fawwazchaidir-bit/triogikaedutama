// Trilogika Edutama — Invoice Management System
//
// Prinsip desain skema (lihat docs/ARCHITECTURE.md):
//  * Uang = bilangan bulat Rupiah (BigInt). Tidak ada float.
//  * Invoice menyimpan SNAPSHOT (pelanggan, perusahaan, rekening, pajak, harga) saat diterbitkan,
//    sehingga perubahan master data tidak mengubah histori.
//  * Tidak ada cascade delete ke data keuangan: semua relasi `Restrict`.
//  * Trigger di migrasi `*_integrity_guards` menegakkan imutabilitas invoice terbit, ledger pembayaran,
//    dan audit log langsung di level database (defense in depth).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  ADMIN
  FINANCE
  STAFF
}

enum InvoiceStatus {
  DRAFT
  /// Diajukan staff, menunggu verifikasi Finance Manager. Isi dikunci; PDF berwatermark DRAFT dan tanpa nomor/cap/tanda tangan.
  SUBMITTED
  ISSUED
  CANCELLED
}

/// Status pembayaran yang DISIMPAN. "Overdue" tidak disimpan: diturunkan dari dueDate + sisa tagihan
/// pada saat query agar tidak butuh cron job dan tidak pernah basi.
enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum DueDateBasis {
  CALENDAR_DAYS
  BUSINESS_DAYS
}

enum TaxMethod {
  /// Harga belum termasuk pajak; pajak ditambahkan di atas.
  EXCLUSIVE
  /// Harga sudah termasuk pajak; pajak diekstrak dari harga (tidak menambah total).
  INCLUSIVE
}

enum NumberReset {
  NEVER
  YEARLY
  MONTHLY
}

enum TerbilangSource {
  TOTAL
  BALANCE
}

enum RupiahStyle {
  /// Rp. 14.000.000,-   (gaya dokumen referensi)
  REFERENCE
  /// Rp 14.000.000
  PLAIN
  /// Rp 14.000.000,00
  DECIMAL
}

enum FileKind {
  LOGO
  STAMP
  SIGNATURE
  PAYMENT_PROOF
  EXPENSE_PROOF
}

// ───────────────────────────── Keuangan (tahap 1: pengeluaran, kas & bank, basis kas) ─────────────────────────────

enum CoaType {
  ASET
  KEWAJIBAN
  EKUITAS
  PENDAPATAN
  BEBAN
}

/// Kelompok arus kas untuk akun lawan: OPERASI (pendapatan/beban), INVESTASI (aset tetap), PENDANAAN (modal/utang).
enum CashFlowSection {
  OPERASI
  INVESTASI
  PENDANAAN
}

enum CashAccountKind {
  KAS
  BANK
}

enum CashDirection {
  IN
  OUT
}

enum LedgerEntryType {
  ENTRY
  REVERSAL
}

enum JournalKind {
  /// Jurnal umum / penyesuaian (mis. penyusutan, koreksi).
  GENERAL
  /// Jurnal saldo awal akun non-kas (aset tetap, utang, modal); bertanggal tepat pada tanggal mulai pembukuan.
  OPENING
}

enum CashEntryStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentEntryType {
  PAYMENT
  REVERSAL
}

// ───────────────────────────── Pengguna & sesi ─────────────────────────────

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  name               String
  passwordHash       String
  role               Role
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions            Session[]
  customers           Customer[]         @relation("CustomerCreatedBy")
  invoicesCreated     Invoice[]          @relation("InvoiceCreatedBy")
  invoicesIssued      Invoice[]          @relation("InvoiceIssuedBy")
  invoicesCancel      Invoice[]          @relation("InvoiceCancelledBy")
  invoicesSubmitted   Invoice[]          @relation("InvoiceSubmittedBy")
  invoicesRejected    Invoice[]          @relation("InvoiceRejectedBy")
  payments            Payment[]
  files               StoredFile[]
  entriesCreated      CashEntry[]        @relation("CashEntryCreatedBy")
  entriesApproved     CashEntry[]        @relation("CashEntryApprovedBy")
  entriesRejected     CashEntry[]        @relation("CashEntryRejectedBy")
  transfersCreated    CashTransfer[]     @relation("CashTransferCreatedBy")
  taxYearInputs       TaxYearInput[]
  statementsCreated   BankStatement[]    @relation("BankStatementCreatedBy")
  statementsFinalized BankStatement[]    @relation("BankStatementFinalizedBy")
  bankMatchesMade     BankMatch[]
  periodsClosed       AccountingPeriod[] @relation("PeriodClosedBy")
  periodsReopened     AccountingPeriod[] @relation("PeriodReopenedBy")
  journalsCreated     JournalEntry[]     @relation("JournalCreatedBy")
  auditLogs           AuditLog[]

  @@map("users")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  /// SHA-256 dari token acak di cookie. Token mentah tidak pernah disimpan.
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  ip         String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Penghitung percobaan login (per email & per IP). Disimpan di DB agar berlaku lintas instance.
model RateLimitBucket {
  key          String    @id
  count        Int       @default(0)
  windowStart  DateTime  @default(now())
  blockedUntil DateTime?

  @@map("rate_limit_buckets")
}

// ───────────────────────────── Master data ─────────────────────────────

model Customer {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  /// Nama ternormalisasi (huruf kecil, tanpa badan usaha/tanda baca) untuk pencegahan duplikasi.
  normalizedName String
  /// Kota ternormalisasi; '' bila kosong. Bersama normalizedName membentuk identitas unik.
  cityKey        String    @default("")
  contactName    String?
  contactTitle   String?
  address        String?
  city           String?
  phone          String?
  email          String?
  npwp           String?
  internalNote   String?
  isActive       Boolean   @default(true)
  archivedAt     DateTime?
  createdById    String    @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  createdBy User      @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  invoices  Invoice[]

  @@unique([normalizedName, cityKey])
  @@index([name])
  @@index([isActive])
  @@map("customers")
}

model TaxConfiguration {
  id             String    @id @default(uuid()) @db.Uuid
  code           String    @unique
  name           String
  /// Tarif dalam basis point: 1100 = 11,00%.
  rateBps        Int
  /// Faktor DPP = dppNumerator / dppDenominator (mis. DPP Nilai Lain 11/12). Default 1/1.
  dppNumerator   Int       @default(1)
  dppDenominator Int       @default(1)
  method         TaxMethod @default(EXCLUSIVE)
  note           String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  products Product[]
  items    InvoiceItem[]

  @@map("tax_configurations")
}

model Product {
  id                  String    @id @default(uuid()) @db.Uuid
  code                String    @unique
  name                String
  category            String?
  fieldOfTraining     String?
  schemeName          String?
  /// Template deskripsi, mis. "{name}\nBidang {field}\n(Skema {scheme})".
  descriptionTemplate String
  unit                String    @default("Pax")
  defaultPrice        BigInt    @default(0)
  taxConfigId         String?   @db.Uuid
  isActive            Boolean   @default(true)
  archivedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  taxConfig TaxConfiguration? @relation(fields: [taxConfigId], references: [id], onDelete: Restrict)
  items     InvoiceItem[]

  @@index([name])
  @@index([isActive])
  @@map("products")
}

/// Satu baris (id = 1). Seluruh identitas lembaga & kebijakan dokumen ada di sini — tidak ada yang ditanam di kode.
model CompanySettings {
  id Int @id @default(1)

  name    String
  tagline String?
  address String
  phone   String?
  email   String?
  website String?
  npwp    String?

  logoFileId      String? @db.Uuid
  stampFileId     String? @db.Uuid
  signatureFileId String? @db.Uuid

  signerName  String
  signerTitle String @default("Finance Manager")
  closingText String @default("Sincerely,")

  defaultPaymentMethod   String       @default("Transfer")
  defaultPaymentTermDays Int          @default(4)
  defaultDueDateBasis    DueDateBasis @default(CALENDAR_DAYS)
  paymentNote            String?
  footerNote             String?

  // Penomoran (lihat src/lib/finance/invoice-number.ts)
  invoiceNumberFormat        String      @default("{SEQ:5}")
  invoiceNumberPrefix        String      @default("")
  invoiceNumberReset         NumberReset @default(NEVER)
  /// Nomor pertama untuk scope baru (mis. 434 pada penomoran tanpa reset, 1 pada tiap tahun baru).
  invoiceNumberStart         Int         @default(1)
  /// Nomor invoice TIDAK BOLEH diterbitkan sebelum Administrator mengonfirmasi nomor awal.
  invoiceNumberConfirmedAt   DateTime?
  invoiceNumberConfirmedById String?     @db.Uuid

  // Tampilan dokumen
  showLogo        Boolean         @default(true)
  showStamp       Boolean         @default(false)
  showSignature   Boolean         @default(false)
  rupiahStyle     RupiahStyle     @default(REFERENCE)
  terbilangSource TerbilangSource @default(TOTAL)

  /// Penutupan buku: pembayaran, entri kas, transfer, dan jurnal bertanggal ≤ tanggal ini ditolak (kosong = tidak ada penutupan).
  booksLockedThrough DateTime? @db.Date

  // ── Profil pajak (tarif TIDAK diasumsikan sistem; diisi pengguna sesuai arahan konsultan pajak) ──
  /// Pengusaha Kena Pajak (informasi pada laporan PPN).
  isPkp               Boolean            @default(false)
  corporateTaxRegime  CorporateTaxRegime @default(NONE)
  /// Tarif dalam basis poin (2200 = 22%). GENERAL: atas penghasilan kena pajak; FINAL: atas peredaran bruto (di luar PPN) per bulan.
  corporateTaxRateBps Int?

  updatedAt DateTime @updatedAt

  @@map("company_settings")
}

// ───────────────────────────── Rekonsiliasi bank ─────────────────────────────

enum BankStatementStatus {
  DRAFT
  FINALIZED
}

enum BankMatchSource {
  PAYMENT
  CASH_ENTRY
  TRANSFER
}

enum BankMatchMethod {
  AUTO
  MANUAL
}

/// Rekening koran satu akun kas/bank untuk satu periode. DRAFT = sedang dicocokkan; FINALIZED = tidak dapat diubah (hanya dapat dibuka kembali
/// bila belum ada rekening koran berikutnya yang difinalisasi).
model BankStatement {
  id             String              @id @default(uuid()) @db.Uuid
  cashAccountId  String              @db.Uuid
  periodStart    DateTime            @db.Date
  periodEnd      DateTime            @db.Date
  /// Saldo awal & akhir menurut bank (Rupiah bulat).
  openingBalance BigInt
  closingBalance BigInt
  label          String?
  note           String?
  status         BankStatementStatus @default(DRAFT)
  createdById    String              @db.Uuid
  createdAt      DateTime            @default(now())
  finalizedAt    DateTime?
  finalizedById  String?             @db.Uuid
  reopenReason   String?

  cashAccount CashAccount         @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  createdBy   User                @relation("BankStatementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  finalizedBy User?               @relation("BankStatementFinalizedBy", fields: [finalizedById], references: [id], onDelete: Restrict)
  lines       BankStatementLine[]
  matches     BankMatch[]

  @@index([cashAccountId, periodEnd])
  @@map("bank_statements")
}

/// Satu baris mutasi pada rekening koran. `amount` BERTANDA: positif = uang masuk (kredit di bank), negatif = uang keluar.
model BankStatementLine {
  id          String   @id @default(uuid()) @db.Uuid
  statementId String   @db.Uuid
  lineNo      Int
  txDate      DateTime @db.Date
  description String
  reference   String?
  amount      BigInt

  statement BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  matches   BankMatch[]

  @@unique([statementId, lineNo])
  @@map("bank_statement_lines")
}

/// Pencocokan satu baris mutasi dengan satu transaksi buku (pembayaran invoice / entri kas / transfer). Satu transaksi hanya dapat dicocokkan SEKALI per akun.
/// Satu baris dapat dicocokkan dengan beberapa transaksi (setoran gabungan); jumlahnya harus sama dengan nilai baris.
model BankMatch {
  id            String          @id @default(uuid()) @db.Uuid
  statementId   String          @db.Uuid
  lineId        String          @db.Uuid
  cashAccountId String          @db.Uuid
  sourceType    BankMatchSource
  sourceId      String          @db.Uuid
  /// Nilai BERTANDA transaksi buku pada akun ini (harus sama persis dengan data sumber).
  amount        BigInt
  method        BankMatchMethod
  matchedById   String          @db.Uuid
  createdAt     DateTime        @default(now())

  statement   BankStatement     @relation(fields: [statementId], references: [id], onDelete: Cascade)
  line        BankStatementLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  cashAccount CashAccount       @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  matchedBy   User              @relation(fields: [matchedById], references: [id], onDelete: Restrict)

  @@unique([cashAccountId, sourceType, sourceId])
  @@index([lineId])
  @@index([statementId])
  @@map("bank_matches")
}

// ───────────────────────────── Penutupan periode bulanan ─────────────────────────────

enum PeriodStatus {
  OPEN
  CLOSED
}

/// Penutupan buku per bulan, berurutan (bulan M hanya dapat ditutup bila M−1 sudah ditutup; dibuka kembali dari yang terakhir). Setiap penutupan menyimpan
/// "foto" neraca saldo akhir bulan beserta hash-nya sehingga perubahan diam-diam pada periode tertutup terdeteksi. Tanggal kunci
/// `company_settings.booksLockedThrough` DIPELIHARA OLEH TRIGGER dari periode yang CLOSED (akhir bulan terakhir).
model AccountingPeriod {
  id           String       @id @default(uuid()) @db.Uuid
  year         Int
  month        Int
  status       PeriodStatus @default(CLOSED)
  closedAt     DateTime?
  closedById   String?      @db.Uuid
  note         String?
  /// Peringatan lunak yang diakui saat menutup: [{ id, label, detail }].
  acknowledged Json?
  snapshot     Json?
  snapshotHash String?
  reopenedAt   DateTime?
  reopenedById String?      @db.Uuid
  reopenReason String?
  createdAt    DateTime     @default(now())

  closedBy   User? @relation("PeriodClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  reopenedBy User? @relation("PeriodReopenedBy", fields: [reopenedById], references: [id], onDelete: Restrict)

  @@unique([year, month])
  @@map("accounting_periods")
}

enum CorporateTaxRegime {
  /// Estimasi PPh badan tidak dihitung.
  NONE
  /// Tarif umum atas penghasilan kena pajak tahunan (laba komersial + koreksi fiskal − kompensasi rugi).
  GENERAL
  /// PPh final atas peredaran bruto bulanan (tanpa koreksi fiskal / kredit PPh 23).
  FINAL
}

/// Input tahunan untuk estimasi PPh badan yang tidak dapat diturunkan dari pembukuan (diisi Finance Manager/akuntan).
model TaxYearInput {
  year              Int      @id
  /// Koreksi fiskal neto (positif menambah, negatif mengurangi penghasilan kena pajak).
  fiscalCorrection  BigInt   @default(0)
  /// Kompensasi kerugian fiskal tahun sebelumnya yang dipakai (mengurangi penghasilan kena pajak).
  lossCompensation  BigInt   @default(0)
  /// Pengurang pajak terutang (mis. fasilitas tarif) dalam Rupiah, dihitung akuntan.
  facilityReduction BigInt   @default(0)
  note              String?
  updatedById       String   @db.Uuid
  updatedAt         DateTime @updatedAt

  updatedBy User @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  @@map("tax_year_inputs")
}

model BankAccount {
  id            String   @id @default(uuid()) @db.Uuid
  /// Label yang dicetak pada "Transfer Via", mis. "MANDIRI-IDR".
  label         String
  accountNumber String
  accountName   String
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  invoices Invoice[]

  @@map("bank_accounts")
}

/// File biner (logo, cap, tanda tangan, bukti bayar). IMUTABEL: mengganti logo = unggah baris baru,
/// sehingga invoice lama tetap menunjuk logo lamanya.
model StoredFile {
  id           String   @id @default(uuid()) @db.Uuid
  kind         FileKind
  originalName String
  mimeType     String
  size         Int
  sha256       String
  data         Bytes
  uploadedById String   @db.Uuid
  createdAt    DateTime @default(now())

  uploadedBy  User        @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  payments    Payment[]
  cashEntries CashEntry[]

  @@index([kind])
  @@map("stored_files")
}

// ───────────────────────────── Invoice ─────────────────────────────

/// Penghitung nomor per "scope" (ALL / 2026 / 2026-01 sesuai kebijakan reset).
/// Dialokasikan HANYA di dalam transaksi penerbitan dengan `UPDATE ... RETURNING` (row lock) —
/// lihat src/server/services/numbering.ts.
model InvoiceNumberSequence {
  scopeKey  String   @id
  nextValue Int
  updatedAt DateTime @updatedAt

  @@map("invoice_number_sequences")
}

model Invoice {
  id String @id @default(uuid()) @db.Uuid

  /// NULL selama DRAFT. Dialokasikan atomik saat diterbitkan; tidak pernah dipakai ulang.
  number      String? @unique
  numberScope String?
  numberSeq   Int?

  status        InvoiceStatus @default(DRAFT)
  paymentStatus PaymentStatus @default(UNPAID)

  invoiceDate     DateTime     @db.Date
  paymentMethod   String
  paymentTermDays Int
  dueDateBasis    DueDateBasis
  dueDate         DateTime     @db.Date
  /// Nomor kontrak / referensi internal.
  reference       String?
  /// Remark yang dicetak pada PDF.
  remark          String?
  internalNote    String?

  customerId           String @db.Uuid
  /// Nama pelanggan: untuk DRAFT mengikuti master saat disimpan; dibekukan saat terbit.
  customerNameSnapshot String
  /// {address, city, npwp, contactName, contactTitle, phone, email} dibekukan saat terbit.
  customerSnapshot     Json?

  bankAccountId     String? @db.Uuid
  bankLabel         String?
  bankAccountNumber String?
  bankAccountName   String?

  // ── Rincian keuangan (Rupiah bulat). Selalu dihitung ulang server dari item + konfigurasi ──
  /// Σ qty × harga (sebelum diskon)
  grossAmount         BigInt @default(0)
  /// Diskon baris + diskon tambahan
  discountAmount      BigInt @default(0)
  /// Input pengguna: diskon tambahan tingkat invoice
  extraDiscountAmount BigInt @default(0)
  /// Σ nilai bersih baris (setelah diskon baris, sebelum diskon tambahan)
  subtotalAmount      BigInt @default(0)
  /// Dasar Pengenaan Pajak (setelah semua diskon)
  taxBaseAmount       BigInt @default(0)
  taxAmount           BigInt @default(0)
  transportAmount     BigInt @default(0)
  adminAmount         BigInt @default(0)
  /// transport + administrasi
  surchargeAmount     BigInt @default(0)
  /// TOTAL INVOICE (Nett Total). DP/pembayaran TIDAK mengurangi nilai ini.
  totalAmount         BigInt @default(0)
  /// DP yang dinyatakan pada invoice; saat terbit otomatis dicatat sebagai baris pembayaran.
  downPaymentAmount   BigInt @default(0)
  /// Σ ledger pembayaran (cache, diperbarui dalam transaksi yang sama dengan pembayaran)
  paidAmount          BigInt @default(0)
  /// totalAmount − paidAmount
  balanceAmount       BigInt @default(0)

  /// Ringkasan pajak per konfigurasi yang dipakai saat diterbitkan.
  taxSnapshot     Json?
  /// Identitas lembaga + penandatangan + logo/cap yang berlaku saat terbit.
  companySnapshot Json?
  /// Opsi tampilan (gaya Rupiah, sumber terbilang) yang berlaku saat terbit.
  displaySnapshot Json?

  /// Alur verifikasi: diajukan (SUBMITTED) → disetujui (ISSUED) atau dikembalikan ke DRAFT dengan alasan.
  submittedAt     DateTime?
  submittedById   String?   @db.Uuid
  rejectedAt      DateTime?
  rejectedById    String?   @db.Uuid
  rejectionReason String?

  issuedAt      DateTime?
  issuedById    String?   @db.Uuid
  cancelledAt   DateTime?
  cancelledById String?   @db.Uuid
  cancelReason  String?

  replacesInvoiceId String? @db.Uuid
  duplicatedFromId  String? @db.Uuid

  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  /// Optimistic concurrency untuk DRAFT: dua editor tidak saling menimpa diam-diam.
  version     Int      @default(1)

  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  bankAccount    BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  createdBy      User         @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  issuedBy       User?        @relation("InvoiceIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)
  cancelledBy    User?        @relation("InvoiceCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  submittedBy    User?        @relation("InvoiceSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  rejectedBy     User?        @relation("InvoiceRejectedBy", fields: [rejectedById], references: [id], onDelete: Restrict)
  replaces       Invoice?     @relation("InvoiceReplacement", fields: [replacesInvoiceId], references: [id], onDelete: Restrict)
  replacedBy     Invoice[]    @relation("InvoiceReplacement")
  duplicatedFrom Invoice?     @relation("InvoiceDuplicate", fields: [duplicatedFromId], references: [id], onDelete: Restrict)
  duplicates     Invoice[]    @relation("InvoiceDuplicate")

  items    InvoiceItem[]
  payments Payment[]

  @@index([status, invoiceDate])
  @@index([customerId])
  @@index([dueDate])
  @@index([paymentStatus])
  @@index([createdById])
  @@index([invoiceDate])
  @@map("invoices")
}

model InvoiceItem {
  id        String @id @default(uuid()) @db.Uuid
  invoiceId String @db.Uuid
  lineNo    Int

  productId   String? @db.Uuid
  productCode String?
  /// Deskripsi TETAP program (hasil template master produk, satu baris). Dasar "Remark" pada invoice —
  /// terpisah dari `description` yang dinamis (boleh memuat nama peserta, dll).
  programText String?
  description String
  /// Maksimal 3 desimal (mis. 1,5 hari).
  quantity    Decimal @db.Decimal(14, 3)
  unit        String
  unitPrice   BigInt

  /// quantity × unitPrice (dibulatkan half-up ke Rupiah)
  grossAmount    BigInt
  discountAmount BigInt @default(0)
  /// grossAmount − discountAmount
  netAmount      BigInt

  taxConfigId String? @db.Uuid
  /// Snapshot konfigurasi pajak baris: {code, name, rateBps, dppNumerator, dppDenominator, method}
  taxSnapshot Json?

  invoice   Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  product   Product?          @relation(fields: [productId], references: [id], onDelete: Restrict)
  taxConfig TaxConfiguration? @relation(fields: [taxConfigId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, lineNo])
  @@index([productId])
  @@map("invoice_items")
}

// ───────────────────────────── Pembayaran (ledger append-only) ─────────────────────────────

/// Baris ledger. TIDAK PERNAH di-UPDATE/DELETE (dijaga trigger). Koreksi = baris REVERSAL bernilai negatif
/// yang menunjuk baris asal (`reversesPaymentId`, unik → satu pembayaran hanya bisa dibalik sekali).
model Payment {
  id                String           @id @default(uuid()) @db.Uuid
  invoiceId         String           @db.Uuid
  entryType         PaymentEntryType @default(PAYMENT)
  reversesPaymentId String?          @unique @db.Uuid
  paymentDate       DateTime         @db.Date
  /// Positif untuk PAYMENT, negatif untuk REVERSAL.
  amount            BigInt
  method            String
  reference         String?
  note              String?
  /// Wajib untuk REVERSAL.
  reason            String?
  isDownPayment     Boolean          @default(false)
  proofFileId       String?          @db.Uuid
  /// PPh yang dipotong pelanggan (mis. PPh 23) pada pembayaran ini: ikut melunasi invoice tetapi BUKAN uang masuk (menjadi kredit pajak, akun 1-1400).
  /// Positif untuk PAYMENT, negatif untuk REVERSAL (cermin pembayaran asal).
  withholdingAmount BigInt           @default(0)
  /// Nomor bukti potong dari pelanggan.
  withholdingRef    String?
  /// Bagian PPN dari (amount + withholdingAmount), dibekukan saat dicatat (kumulatif proporsional terhadap pajak invoice). Negatif untuk REVERSAL.
  vatAmount         BigInt           @default(0)
  /// Akun kas/bank penerima (null = belum dialokasikan, mis. dicatat sebelum modul kas dikonfigurasi).
  cashAccountId     String?          @db.Uuid
  recordedById      String           @db.Uuid
  createdAt         DateTime         @default(now())

  cashAccount CashAccount? @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  recordedBy  User         @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  proofFile   StoredFile?  @relation(fields: [proofFileId], references: [id], onDelete: Restrict)
  reverses    Payment?     @relation("PaymentReversal", fields: [reversesPaymentId], references: [id], onDelete: Restrict)
  reversal    Payment?     @relation("PaymentReversal")

  @@index([invoiceId])
  @@index([paymentDate])
  @@index([cashAccountId])
  @@map("payments")
}

// ───────────────────────────── Keuangan: bagan akun, akun kas/bank, entri kas, transfer ─────────────────────────────

/// Bagan akun (usulan SAK EMKM; dapat disesuaikan Administrator). Akun `manualEntry=true` boleh menjadi akun lawan entri kas manual.
/// Akun `isSystem` dicadangkan (pendapatan invoice, piutang, pajak, dst.) untuk tahap akuntansi berikutnya.
model CoaAccount {
  id          String          @id @default(uuid()) @db.Uuid
  code        String          @unique
  name        String
  type        CoaType
  section     CashFlowSection @default(OPERASI)
  manualEntry Boolean         @default(false)
  isSystem    Boolean         @default(false)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  cashAccounts CashAccount[]
  entries      CashEntry[]
  journalLines JournalLine[]

  @@map("coa_accounts")
}

/// Kas / rekening bank perusahaan. Saldo = saldo awal (manual) + mutasi sejak `openingDate`.
model CashAccount {
  id             String          @id @default(uuid()) @db.Uuid
  name           String          @unique
  kind           CashAccountKind
  coaAccountId   String          @db.Uuid
  isDefault      Boolean         @default(false)
  isActive       Boolean         @default(true)
  openingBalance BigInt          @default(0)
  openingDate    DateTime        @db.Date
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  coaAccount    CoaAccount      @relation(fields: [coaAccountId], references: [id], onDelete: Restrict)
  payments      Payment[]
  entries       CashEntry[]
  transfersFrom CashTransfer[]  @relation("TransferFrom")
  transfersTo   CashTransfer[]  @relation("TransferTo")
  statements    BankStatement[]
  bankMatches   BankMatch[]

  @@map("cash_accounts")
}

/// Entri kas manual (pengeluaran, penerimaan lain, investasi, pendanaan). Setelah disetujui TIDAK PERNAH diubah/dihapus;
/// koreksi = baris REVERSAL (dijaga trigger DB). Hanya entri APPROVED yang masuk saldo & laporan.
model CashEntry {
  id               String          @id @default(uuid()) @db.Uuid
  entryType        LedgerEntryType @default(ENTRY)
  reversesEntryId  String?         @unique @db.Uuid
  entryDate        DateTime        @db.Date
  direction        CashDirection
  amount           BigInt
  cashAccountId    String          @db.Uuid
  counterAccountId String          @db.Uuid
  description      String
  payee            String?
  reference        String?
  proofFileId      String?         @db.Uuid
  status           CashEntryStatus @default(PENDING)
  /// Wajib untuk REVERSAL.
  reason           String?
  createdById      String          @db.Uuid
  approvedById     String?         @db.Uuid
  approvedAt       DateTime?
  rejectedById     String?         @db.Uuid
  rejectedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime        @default(now())

  cashAccount    CashAccount @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  counterAccount CoaAccount  @relation(fields: [counterAccountId], references: [id], onDelete: Restrict)
  proofFile      StoredFile? @relation(fields: [proofFileId], references: [id], onDelete: Restrict)
  createdBy      User        @relation("CashEntryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy     User?       @relation("CashEntryApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  rejectedBy     User?       @relation("CashEntryRejectedBy", fields: [rejectedById], references: [id], onDelete: Restrict)
  reverses       CashEntry?  @relation("CashEntryReversal", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversal       CashEntry?  @relation("CashEntryReversal")

  @@index([entryDate])
  @@index([cashAccountId])
  @@index([counterAccountId])
  @@index([status])
  @@map("cash_entries")
}

/// Pemindahan dana antar akun kas/bank (tidak memengaruhi laba rugi). Append-only; koreksi = transfer pembalik.
model CashTransfer {
  id                 String          @id @default(uuid()) @db.Uuid
  entryType          LedgerEntryType @default(ENTRY)
  reversesTransferId String?         @unique @db.Uuid
  transferDate       DateTime        @db.Date
  fromAccountId      String          @db.Uuid
  toAccountId        String          @db.Uuid
  amount             BigInt
  description        String?
  reference          String?
  reason             String?
  createdById        String          @db.Uuid
  createdAt          DateTime        @default(now())

  fromAccount CashAccount   @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount   CashAccount   @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  createdBy   User          @relation("CashTransferCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reverses    CashTransfer? @relation("CashTransferReversal", fields: [reversesTransferId], references: [id], onDelete: Restrict)
  reversal    CashTransfer? @relation("CashTransferReversal")

  @@index([transferDate])
  @@map("cash_transfers")
}

/// Jurnal MANUAL (umum/penyesuaian/saldo awal). Jurnal dari kas (pembayaran invoice, entri kas, transfer, saldo awal kas) TIDAK disimpan di sini:
/// diturunkan langsung dari tabel sumbernya sehingga tidak mungkin berselisih. Append-only & seimbang (dijaga trigger DB).
model JournalEntry {
  id                String          @id @default(uuid()) @db.Uuid
  /// Nomor urut tampilan (JU-000123); celah mungkin terjadi bila transaksi dibatalkan.
  numberSeq         Int             @unique @default(autoincrement())
  kind              JournalKind     @default(GENERAL)
  entryType         LedgerEntryType @default(ENTRY)
  reversesJournalId String?         @unique @db.Uuid
  journalDate       DateTime        @db.Date
  description       String
  reference         String?
  /// Wajib untuk REVERSAL.
  reason            String?
  createdById       String          @db.Uuid
  createdAt         DateTime        @default(now())

  createdBy User          @relation("JournalCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reverses  JournalEntry? @relation("JournalReversal", fields: [reversesJournalId], references: [id], onDelete: Restrict)
  reversal  JournalEntry? @relation("JournalReversal")
  lines     JournalLine[]

  @@index([journalDate])
  @@map("journal_entries")
}

model JournalLine {
  id        String  @id @default(uuid()) @db.Uuid
  journalId String  @db.Uuid
  lineNo    Int
  accountId String  @db.Uuid
  debit     BigInt  @default(0)
  credit    BigInt  @default(0)
  memo      String?

  journal JournalEntry @relation(fields: [journalId], references: [id], onDelete: Restrict)
  account CoaAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([journalId, lineNo])
  @@index([accountId])
  @@map("journal_lines")
}

// ───────────────────────────── Audit ─────────────────────────────

/// Append-only (dijaga trigger). Ditulis di transaksi yang sama dengan perubahan datanya.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  createdAt  DateTime @default(now())
  actorId    String?  @db.Uuid
  actorEmail String?
  actorRole  Role?
  /// mis. "invoice.issue", "payment.reverse", "customer.update"
  action     String
  entityType String
  entityId   String?
  summary    String?
  before     Json?
  after      Json?
  reason     String?
  ip         String?
  userAgent  String?

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}
